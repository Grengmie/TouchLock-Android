<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        动态广播接收器所需的签名级权限。

        androidx.core 1.12 的 AndroidManifest.xml 中声明了
        ${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION 这条权限，
        Android 13 以下的系统在调用
        ContextCompat.registerReceiver(..., RECEIVER_NOT_EXPORTED) 时会校验它，
        缺失就直接抛 RuntimeException（"Permission ... is required by your application
        to receive broadcasts"）。

        正常用 Gradle 构建时，清单合并会自动带入这条权限；
        本项目使用的是手工（aapt2 + kotlinc + d8）出包流程，不合并依赖库清单，
        因此必须在这里显式声明，否则开启无障碍服务后服务会在
        onServiceConnected 中崩溃并被系统反复重启（表现为「屡次停止运行」）。
    -->
    <permission
        android:name="com.example.touchlock.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.example.touchlock.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <!-- 应用声明：入口 Activity + 无障碍服务 -->
    <application
        android:name=".TouchLockApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TouchLock">

        <!-- 入口界面：显示说明文字并引导用户开启无障碍服务 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            无障碍服务：
            - android:permission 表示只有系统（持有该权限）才能绑定本服务；
            - intent-filter 的动作名由系统无障碍框架识别，名称固定不可改；
            - meta-data 指向服务配置文件 accessibility_service_config.xml。
            exported 显式写成 true（有 intent-filter 时系统要求导出），
            外部无法直接调用，仍需系统签名权限才能绑定。
        -->
        <service
            android:name=".TouchLockAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
